From 15c56d88f8ad1b26793f54fe87b14a746d7a23c4 Mon Sep 17 00:00:00 2001
From: adriend1102 <114516137+adriend1102@users.noreply.github.com>
Date: Mon, 2 Nov 2026 20:31:48 +0100
Subject: [PATCH 15/29] PS5 integration:
 0061-server-upscale-saved-to-the-gallery

# Conflicts:
#	examples/server/routes_sdcpp.cpp

diff --git a/examples/server/api.md b/examples/server/api.md
index 97cbd66..d2578cb 100644
--- a/examples/server/api.md
+++ b/examples/server/api.md
@@ -1056,6 +1056,7 @@ Request fields:
 | `tile_size` | `integer` | Tile size, defaulting to the server's `--upscale-tile-size` |
 | `output_format` | `string` | `png`, `jpeg`, or `webp` when built with WebP support (default `png`); unsupported formats return 400 |
 | `output_compression` | `integer` | Range is clamped to `0..100` |
+| `return_image` | `boolean` | PS5SD: `false` leaves `images` empty (the result is saved to the gallery); default `true` |
 
 Response fields:
 
@@ -1064,6 +1065,7 @@ Response fields:
 | `images` | `array<object>` | One image |
 | `images[].index` | `integer` | |
 | `images[].b64_json` | `string` | Base64-encoded image bytes |
+| `saved` | `array<string>` | PS5SD: the file names the result was saved under in `--output-dir` (the gallery); empty without it |
 | `upscaler` | `string` | The upscaler actually used |
 | `scale` | `integer` | The model's scale factor |
 | `repeats` | `integer` | How many times it was run |
diff --git a/examples/server/routes_sdcpp.cpp b/examples/server/routes_sdcpp.cpp
index 5ebbc63..a19d233 100644
--- a/examples/server/routes_sdcpp.cpp
+++ b/examples/server/routes_sdcpp.cpp
@@ -10,6 +10,8 @@
 #include "common/media_io.h"
 #include "common/resource_owners.hpp"
 #include "model_catalog.h"
+#include "gallery.h"
+#include "server_hooks.h"
 
 namespace fs = std::filesystem;
 
@@ -596,6 +598,14 @@ void register_sdcpp_api_endpoints(httplib::Server& svr, ServerRuntime& rt) {
 
             // One GPU: an upscale must not run while a generation is using it.
             std::lock_guard<std::mutex> ctx_lock(*runtime->sd_ctx_mutex);
+            // PS5SD: the application sees an upscale like a generation (its screen
+            // shows it, and the saved result); failed unless done is set.
+            struct UpscaleActivity {
+                bool done = false;
+                std::string saved;
+                UpscaleActivity(int w, int h, int repeats) { sd_activity_job_begin("upscale", "", w, h, repeats); }
+                ~UpscaleActivity() { sd_activity_job_end(done ? 1 : 0, done ? saved.c_str() : ""); }
+            } activity(static_cast<int>(input.get().width), static_cast<int>(input.get().height), repeats);
             UpscalerCtxPtr upscaler_ctx(new_upscaler_ctx(model_path.c_str(),
                                                          runtime->ctx_params->diffusion_conv_direct,
                                                          runtime->ctx_params->n_threads,
@@ -651,16 +661,33 @@ void register_sdcpp_api_endpoints(httplib::Server& svr, ServerRuntime& rt) {
                 return;
             }
 
+            // PS5SD: saved to --output-dir like every generated image, so it is in the gallery.
+            json saved_names = json::array();
+            {
+                SDImageVec to_save;
+                to_save.push_back(current.release());
+                const std::vector<std::string> saved = save_output_images(*runtime->svr_params, to_save);
+                for (const std::string& path : saved) {
+                    saved_names.push_back(fs::u8path(path).filename().u8string());
+                }
+                activity.saved = saved_paths(saved);
+                activity.done  = true;
+            }
+
             json out;
             out["generation_info"] = json::parse(generation_info);
-            out["upscaler"]        = used_name;
-            out["scale"]           = factor;
-            out["repeats"]         = repeats;
-            out["width"]           = result.width;
-            out["height"]          = result.height;
-            out["output_format"]   = format;
-            json images            = json::array();
-            images.push_back({{"index", 0}, {"b64_json", base64_encode(image_bytes)}});
+            out["saved"] = std::move(saved_names);
+            out["upscaler"] = used_name;
+            out["scale"] = factor;
+            out["repeats"] = repeats;
+            out["width"] = result.width;
+            out["height"] = result.height;
+            out["output_format"] = format;
+            json images = json::array();
+            // PS5SD: return_image=false keeps large upscaled outputs in the gallery only.
+            if (body.value("return_image", true)) {
+                images.push_back({{"index", 0}, {"b64_json", base64_encode(image_bytes)}});
+            }
             out["images"] = std::move(images);
             res.set_content(out.dump(), "application/json");
             res.status = 200;
-- 
