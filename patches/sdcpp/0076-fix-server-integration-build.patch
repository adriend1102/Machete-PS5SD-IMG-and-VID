 std::string generation_info_to_image_metadata(const std::string& info) {
     if (info.empty())
         return "";
-    const auto parameters = generation_info_to_webui(info);
+    auto parameters = generation_info_to_webui(info);
+    if (parameters.empty())
+        return info;
+    const auto parsed = nlohmann::json::parse(info, nullptr, false);
+    if (parsed.is_object() && parsed.contains("ps5sd") && parsed.at("ps5sd").is_object()) {
+        const auto& extra = parsed.at("ps5sd");
+        std::string fields;
+        const auto preset = extra.value("preset", std::string());
+        if (!preset.empty())
+            fields += "Preset: " + preset + ", ";
+        if (extra.contains("seconds") && extra.at("seconds").is_number()) {
+            char time[32];
+            std::snprintf(time, sizeof(time), "Time: %.1f s, ", extra.at("seconds").get<double>());
+            fields += time;
+        }
+        const auto at_version = parameters.rfind("Version: stable-diffusion.cpp");
+        if (at_version != std::string::npos)
+            parameters.insert(at_version, fields);
+    }
     return parameters.empty() ? info : parameters + ", SDCPP: " + info;
 }
