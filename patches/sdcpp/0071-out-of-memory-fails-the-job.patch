             workers.emplace_back([&, file_path, is_zip]() {
+              auto work = [&]() {
                 std::ifstream file;
                 zip_t* zip = nullptr;
                 if (is_zip) {
@@ -1378,6 +1383,16 @@ bool ModelLoader::load_tensors(on_new_tensor_cb_t on_new_tensor_cb,
                 if (zip != nullptr) {
                     zip_close(zip);
                 }
+              };
+              try {
+                  work();
+              } catch (const std::bad_alloc&) {
+                  LOG_ERROR("loading tensors from '%s': out of memory", file_path.c_str());
+                  failed = true;
+              } catch (const std::exception& error) {
+                  LOG_ERROR("loading tensors from '%s' failed: %s", file_path.c_str(), error.what());
+                  failed = true;
+              }
             });
         }
 
