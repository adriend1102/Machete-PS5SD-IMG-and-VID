 /** Populates generation params from a JSON payload (server APIs); returns false on any malformed field. */
+std::string merge_ref_image_args(const std::string& base, const std::string& request) {
+    // A request that only sets e.g. ref_boost must not drop the model's own
+    // --ref-image-args (preset=krea2_edit from the model file). The engine lets
+    // later keys win, except `preset`, where the first one wins.
+    auto keys_of = [](const std::string& args) {
+        std::vector<std::pair<std::string, std::string>> items;
+        size_t pos = 0;
+        while (pos <= args.size()) {
+            size_t end       = args.find(',', pos);
+            std::string item = args.substr(pos, end == std::string::npos ? std::string::npos : end - pos);
+            size_t first     = item.find_first_not_of(" \t");
+            size_t last      = item.find_last_not_of(" \t");
+            if (first != std::string::npos) {
+                item          = item.substr(first, last - first + 1);
+                size_t eq     = item.find('=');
+                std::string k = item.substr(0, eq);
+                k.erase(k.find_last_not_of(" \t") + 1);
+                items.emplace_back(k, item);
+            }
+            if (end == std::string::npos) {
+                break;
+            }
+            pos = end + 1;
+        }
+        return items;
+    };
+    if (request.find_first_not_of(" \t,") == std::string::npos) {
+        return base;
+    }
+    const auto request_items = keys_of(request);
+    bool request_has_preset  = false;
+    for (const auto& item : request_items) {
+        request_has_preset = request_has_preset || item.first == "preset";
+    }
+    std::string merged;
+    for (const auto& item : keys_of(base)) {
+        if (request_has_preset && item.first == "preset") {
+            continue;
+        }
+        merged += (merged.empty() ? "" : ",") + item.second;
+    }
+    for (const auto& item : request_items) {
+        merged += (merged.empty() ? "" : ",") + item.second;
+    }
+    return merged;
+}
