+        // Flash attention with ref_boost's bias on the query rows [q_begin, q_begin + q_count),
+        // in chunks of row_mask's rows; the other rows have none.
+        ggml_tensor* ref_boost_attention(GGMLRunnerContext* ctx,
+                                         ggml_tensor* q,
+                                         ggml_tensor* k,
+                                         ggml_tensor* v,
+                                         ggml_tensor* pe,
+                                         const Krea2RefBoost& boost) {
+            const int64_t n_head = q->ne[1];
+            q                    = Rope::apply_rope(ctx, q, pe, true);  // [N*n_head, L, d_head]
+            k                    = Rope::apply_rope(ctx, k, pe, true);  // [N*n_kv_head, L, d_head]
+            return ref_boost_flash_attention(ctx, q, k, v, n_head, boost);
+        }
+
+        // q: [N*n_head, L_q, d_head], k: [N*n_kv_head, L_k, d_head] (after RoPE), v: [N, L_k, n_kv_head, d_head].
+        static ggml_tensor* ref_boost_flash_attention(GGMLRunnerContext* ctx,
+                                                      ggml_tensor* q,
+                                                      ggml_tensor* k,
+                                                      ggml_tensor* v,
+                                                      int64_t n_head,
+                                                      const Krea2RefBoost& boost) {
+            ggml_context* g      = ctx->ggml_ctx;
+            const int64_t L_q    = q->ne[1];
+            const int64_t L_k    = k->ne[1];
+            const int64_t d_head = v->ne[0];
+            const int64_t N      = v->ne[3];
+            const int64_t n_kv   = k->ne[2] / N;
+
+            auto k16 = ggml_cast(g, k, GGML_TYPE_F16);
+            auto vp  = ggml_permute(g, v, 0, 2, 1, 3);
+            auto v16 = ggml_cast(g, vp, GGML_TYPE_F16);
+            if (!ggml_backend_supports_op(ctx->backend, v16)) {
+                v16 = ggml_cast(g, ggml_ext_cont(g, vp), GGML_TYPE_F16);
+            }
+            v16 = ggml_reshape_3d(g, v16, d_head, L_k, n_kv * N);
+
+            const float scale = 1.0f / std::sqrt(static_cast<float>(d_head));
+            const int64_t rows = boost.row_mask->ne[1];
+            ggml_tensor* out   = nullptr;
+            auto run           = [&](int64_t begin, int64_t count, ggml_tensor* mask) {
+                if (count <= 0) {
+                    return;
+                }
+                auto qv = ggml_view_3d(g, q, d_head, count, q->ne[2], q->nb[1], q->nb[2], begin * q->nb[1]);
+                auto o  = ggml_flash_attn_ext(g, qv, k16, v16, mask, scale, 0, 0);
+                ggml_prec_set_acc(o, GGML_PREC_F32);
+                out = out == nullptr ? o : ggml_concat(g, out, o, 2);  // [d_head, N*n_head, rows, 1]
+            };
+            run(0, boost.q_begin, nullptr);
+            for (int64_t r = 0; r < boost.q_count; r += rows) {
+                run(boost.q_begin + r, std::min(rows, boost.q_count - r), boost.row_mask);
+            }
