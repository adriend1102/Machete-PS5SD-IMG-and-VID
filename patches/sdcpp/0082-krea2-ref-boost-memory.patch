+            out = ggml_view_4d(g, out, d_head, n_head, L_q, N, out->nb[1], out->nb[2], out->nb[1] * n_head, 0);
+            out = ggml_ext_cont(g, out);
+            return ggml_reshape_3d(g, out, d_head * n_head, L_q, N);  // [N, L_q, C]
+        }
