+            // Krea2 ref_boost (comfyui-krea2edit Krea2EditModelPatch.ref_boost): add log(ref_boost)
+            // to the attention logits of target queries on the keys of the LAST reference, in
+            // every block. Sequence here is [text | target | refs...]; the reference node uses
+            // [text | refs... | target], which is the same attention up to a permutation.
+            Rope::QueryBandBias ref_boost;
+            const bool boost_requested = ref_image_params.ref_boost != 1.0f;
+            if (boost_requested && ref_latents.empty()) {
+                LOG_WARN("krea2 ref_boost=%.3f has no effect: no reference latent reaches the DiT", ref_image_params.ref_boost);
+            } else if (boost_requested) {
+                const int64_t patch  = config.patch_size;
+                const auto patch_len = [patch](const ggml_tensor* latent) {
