         // pe: [L, d_head/2, 2, 2]
         // return: [N, L, n_head*d_head]
@@ -1142,6 +1224,9 @@ namespace Rope {
         k = apply_rope(ctx, k, pe, rope_interleaved);  // [N*n_head, L, d_head]
 
         auto x = ggml_ext_attention_ext(ctx, q, k, v, n_head, mask, true, ctx->flash_attn_enabled, kv_scale);  // [N, L, n_head*d_head]
+        if (band_bias != nullptr && band_bias->active()) {
+            x = apply_query_band_bias(ctx, x, q, k, v, n_head, *band_bias, kv_scale);
+        }
         return x;
     }
 };  // namespace Rope
