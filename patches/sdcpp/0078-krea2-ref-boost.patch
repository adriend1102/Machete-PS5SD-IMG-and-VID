+    // Additive attention-logit bias applied to one contiguous band of queries only.
+    // Krea2 ref_boost uses it to add log(boost) to the keys of the last reference
+    // for the target (noisy image) queries, exactly like comfyui-krea2edit's
+    // _ref_attn_bias, without materializing an [L, L] mask: the bias of every query
+    // in the band is the same key row, so `row_bias` holds that row repeated `rows`
+    // times ([L_k, rows]) and each query chunk views it.
+    struct QueryBandBias {
+        ggml_tensor* row_bias = nullptr;  // [L_k, rows], F32
+        int64_t q_begin       = 0;
+        int64_t q_count       = 0;
+
+        bool active() const {
+            return row_bias != nullptr && q_count > 0;
+        }
+    };
+
+    // q, k: [N*n_head, L, d_head] (RoPE applied), v: [N, L_k, n_kv_head, d_head].
+    // Return: [N, L, n_head*d_head].
+    // Queries outside the band use the normal attention path (Flash Attention when
+    // enabled, unmasked). Queries inside the band use manual attention in chunks of
+    // row_bias->ne[1] rows, so the score tensor stays [L_k, rows, n_head] and the
+    // Vulkan Flash Attention mask path (unreliable on RADV) is never used.
+    __STATIC_INLINE__ ggml_tensor* attention_query_band_bias(GGMLRunnerContext* ctx,
+                                                             ggml_tensor* q,
+                                                             ggml_tensor* k,
+                                                             ggml_tensor* v,
+                                                             int64_t n_head,
+                                                             const QueryBandBias& band,
+                                                             float kv_scale = 1.0f) {
+        ggml_context* gctx   = ctx->ggml_ctx;
+        const int64_t L_q    = q->ne[1];
+        const int64_t L_k    = k->ne[1];
+        const int64_t d_head = v->ne[0];
+        const int64_t N      = v->ne[3];
+        const int64_t rows   = band.row_bias->ne[1];
+        GGML_ASSERT(band.q_begin >= 0 && band.q_count > 0 && band.q_begin + band.q_count <= L_q);
+        GGML_ASSERT(band.row_bias->ne[0] == L_k && rows > 0);
+        GGML_ASSERT(band.row_bias->type == GGML_TYPE_F32 && ggml_is_contiguous(band.row_bias));
+
+        auto q_rows = [&](int64_t start, int64_t count) {
+            return ggml_view_3d(gctx, q, q->ne[0], count, q->ne[2], q->nb[1], q->nb[2], start * q->nb[1]);
+        };
+
+        std::vector<ggml_tensor*> parts;
+        if (band.q_begin > 0) {
+            parts.push_back(ggml_ext_attention_ext(ctx, q_rows(0, band.q_begin), k, v, n_head, nullptr, true,
+                                                   ctx->flash_attn_enabled, kv_scale));
+        }
+
+        if (ctx->attn_scale > 0.f) {
+            kv_scale = ctx->attn_scale;  // same override as ggml_ext_attention_ext(GGMLRunnerContext*)
+        }
+        const float scale = 1.0f / std::sqrt(static_cast<float>(d_head));
+        ggml_tensor* k_in = kv_scale != 1.0f ? ggml_scale(gctx, k, kv_scale) : k;
+        ggml_tensor* v_t  = ggml_cont(gctx, ggml_permute(gctx, v, 1, 2, 0, 3));  // [N, n_kv_head, d_head, L_k]
+        v_t               = ggml_reshape_3d(gctx, v_t, L_k, d_head, v_t->ne[2] * N);
+        if (kv_scale != 1.0f) {
+            v_t = ggml_scale(gctx, v_t, kv_scale);
+        }
+
+        std::vector<ggml_tensor*> band_chunks;
+        band_chunks.reserve((band.q_count + rows - 1) / rows);
+        const int64_t band_end = band.q_begin + band.q_count;
+        for (int64_t start = band.q_begin; start < band_end; start += rows) {
+            const int64_t count = std::min(rows, band_end - start);
+            ggml_tensor* q_chunk = ggml_cont(gctx, q_rows(start, count));  // [N*n_head, count, d_head]
+            ggml_tensor* kq      = ggml_mul_mat(gctx, k_in, q_chunk);      // [N*n_head, count, L_k]
+            ggml_prec_set_acc(kq, GGML_PREC_F32);
+            ggml_tensor* bias = ggml_view_2d(gctx, band.row_bias, L_k, count, band.row_bias->nb[1], 0);
+            kq                = ggml_soft_max_ext(gctx, kq, bias, scale / kv_scale, 0.0f);
+            band_chunks.push_back(ggml_mul_mat(gctx, v_t, kq));  // [N*n_head, count, d_head]
+        }
+        ggml_tensor* band_out = ggml_ext_vec_concat(gctx, band_chunks, 1);       // [N*n_head, q_count, d_head]
+        band_out              = ggml_reshape_4d(gctx, band_out, d_head, band.q_count, n_head, N);
+        band_out              = ggml_cont(gctx, ggml_permute(gctx, band_out, 0, 2, 1, 3));  // [N, q_count, n_head, d_head]
+        band_out              = ggml_reshape_3d(gctx, band_out, d_head * n_head, band.q_count, N);
+        if (kv_scale != 1.0f) {
+            band_out = ggml_scale(gctx, band_out, 1.0f / kv_scale);
+        }
+        parts.push_back(band_out);
+
+        if (band_end < L_q) {
+            parts.push_back(ggml_ext_attention_ext(ctx, q_rows(band_end, L_q - band_end), k, v, n_head, nullptr, true,
+                                                   ctx->flash_attn_enabled, kv_scale));
+        }
+        return parts.size() == 1 ? parts[0] : ggml_ext_vec_concat(gctx, parts, 1);
+    }
+
     __STATIC_INLINE__ ggml_tensor* attention(GGMLRunnerContext* ctx,
                                              ggml_tensor* q,
                                              ggml_tensor* k,
@@ -1132,7 +1220,8 @@ namespace Rope {
                                              ggml_tensor* pe,
                                              ggml_tensor* mask,
                                              float kv_scale        = 1.0f,
-                                             bool rope_interleaved = true) {
