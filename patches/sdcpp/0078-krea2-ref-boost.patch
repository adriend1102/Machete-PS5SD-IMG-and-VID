+    // An additive logit bias for one contiguous band of queries (Krea2 ref_boost: log(boost)
+    // on the keys of the last reference, for the target queries only). `key_bias` is one
+    // [L_k] row shared by every query of the band, so no [L, L] mask is built.
+    struct QueryBandBias {
+        ggml_tensor* key_bias = nullptr;  // [L_k], F32
+        int64_t q_begin       = 0;
+        int64_t q_count       = 0;
+        int64_t chunk_rows    = 64;
+
+        bool active() const {
+            return key_bias != nullptr && q_count > 0;
+        }
+    };
+
+    // q, k: [N*n_head, L, d_head] (RoPE applied), v: [N, L_k, n_kv_head, d_head].
+    // `unbiased` is the plain attention of every query, [N, L, n_head*d_head]; the band's rows
+    // of it are replaced by manual attention with the bias, computed in query chunks so the
+    // score tensor stays [L_k, chunk_rows, n_head]. Only plain ops (mul_mat, scale, add with
+    // broadcast, soft_max without mask, concat) are used on the band.
+    __STATIC_INLINE__ ggml_tensor* apply_query_band_bias(GGMLRunnerContext* ctx,
+                                                         ggml_tensor* unbiased,
+                                                         ggml_tensor* q,
+                                                         ggml_tensor* k,
+                                                         ggml_tensor* v,
+                                                         int64_t n_head,
+                                                         const QueryBandBias& band,
+                                                         float kv_scale) {
+        ggml_context* gctx   = ctx->ggml_ctx;
+        const int64_t L_q    = q->ne[1];
+        const int64_t L_k    = k->ne[1];
+        const int64_t d_head = v->ne[0];
+        const int64_t N      = v->ne[3];
+        GGML_ASSERT(band.q_begin >= 0 && band.q_count > 0 && band.q_begin + band.q_count <= L_q);
+        GGML_ASSERT(band.key_bias->ne[0] == L_k && band.chunk_rows > 0);
+        GGML_ASSERT(unbiased->ne[1] == L_q && unbiased->ne[2] == N);
+
+        if (ctx->attn_scale > 0.f) {
+            kv_scale = ctx->attn_scale;
+        }
+        const float scale = 1.0f / std::sqrt(static_cast<float>(d_head)) / kv_scale;
+        ggml_tensor* k_in = kv_scale != 1.0f ? ggml_scale(gctx, k, kv_scale) : k;
+        ggml_tensor* v_t  = ggml_cont(gctx, ggml_permute(gctx, v, 1, 2, 0, 3));  // [N, n_kv_head, d_head, L_k]
+        v_t               = ggml_reshape_3d(gctx, v_t, L_k, d_head, v_t->ne[2] * N);
+        if (kv_scale != 1.0f) {
+            v_t = ggml_scale(gctx, v_t, kv_scale);
+        }
+
+        std::vector<ggml_tensor*> chunks;
+        const int64_t band_end = band.q_begin + band.q_count;
+        for (int64_t start = band.q_begin; start < band_end; start += band.chunk_rows) {
+            const int64_t count  = std::min(band.chunk_rows, band_end - start);
+            ggml_tensor* q_chunk = ggml_view_3d(gctx, q, q->ne[0], count, q->ne[2], q->nb[1], q->nb[2], start * q->nb[1]);
+            q_chunk              = ggml_cont(gctx, q_chunk);              // [N*n_head, count, d_head]
+            ggml_tensor* kq      = ggml_mul_mat(gctx, k_in, q_chunk);     // [N*n_head, count, L_k]
+            ggml_prec_set_acc(kq, GGML_PREC_F32);
+            kq = ggml_scale_inplace(gctx, kq, scale);
+            kq = ggml_add_inplace(gctx, kq, band.key_bias);
+            kq = ggml_soft_max_inplace(gctx, kq);
+            chunks.push_back(ggml_mul_mat(gctx, v_t, kq));  // [N*n_head, count, d_head]
+        }
+        ggml_tensor* biased = ggml_ext_vec_concat(gctx, chunks, 1);  // [N*n_head, q_count, d_head]
+        biased              = ggml_reshape_4d(gctx, biased, d_head, band.q_count, n_head, N);
+        biased              = ggml_cont(gctx, ggml_permute(gctx, biased, 0, 2, 1, 3));  // [N, q_count, n_head, d_head]
+        biased              = ggml_reshape_3d(gctx, biased, d_head * n_head, band.q_count, N);
+        if (kv_scale != 1.0f) {
+            biased = ggml_scale(gctx, biased, 1.0f / kv_scale);
+        }
+
+        auto rows = [&](int64_t start, int64_t count) {
+            return ggml_view_3d(gctx, unbiased, unbiased->ne[0], count, N, unbiased->nb[1], unbiased->nb[2], start * unbiased->nb[1]);
+        };
+        ggml_tensor* out = biased;
+        if (band.q_begin > 0) {
+            out = ggml_concat(gctx, rows(0, band.q_begin), out, 1);
+        }
+        if (band_end < L_q) {
+            out = ggml_concat(gctx, out, rows(band_end, L_q - band_end), 1);
+        }
+        return out;
+    }
+
