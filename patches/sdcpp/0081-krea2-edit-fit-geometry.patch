index 607ec18..8368566 100644
--- a/src/pipeline/image.cpp
+++ b/src/pipeline/image.cpp
@@ -16,6 +16,42 @@
 
 namespace sd::pipeline {
 
+    // comfyui-krea2edit's pixel-path "fit" (the geometry Krea2 Identity Edit was trained on):
+    // a reference whose aspect ratio is within 8% of the target is center-cropped to it and
+    // resized to exactly the target size; otherwise it is fitted inside the target on the
+    // /16 grid, after a center crop that makes the fitted size land on that grid exactly.
+    // Image tensors are [W, H, C, N].
+    static sd::Tensor<float> fit_ref_image_to_target(const sd::Tensor<float>& image, int target_w, int target_h) {
+        const int64_t iw = image.shape()[0];
+        const int64_t ih = image.shape()[1];
+        const double sc  = std::min(static_cast<double>(target_h) / ih, static_cast<double>(target_w) / iw);
+        int64_t crop_w, crop_h, out_w, out_h;
+        constexpr double crop_tolerance = 0.08;
+        if (ih * sc >= target_h * (1.0 - crop_tolerance) && iw * sc >= target_w * (1.0 - crop_tolerance)) {
+            const double s = std::max(static_cast<double>(target_h) / ih, static_cast<double>(target_w) / iw);
+            crop_h         = std::min<int64_t>(ih, static_cast<int64_t>(std::llround(target_h / s)));
+            crop_w         = std::min<int64_t>(iw, static_cast<int64_t>(std::llround(target_w / s)));
+            out_h          = target_h;
+            out_w          = target_w;
+        } else {
+            out_h  = std::min<int64_t>(std::max<int64_t>(16, static_cast<int64_t>(ih * sc) / 16 * 16), std::max(16, target_h / 16 * 16));
+            out_w  = std::min<int64_t>(std::max<int64_t>(16, static_cast<int64_t>(iw * sc) / 16 * 16), std::max(16, target_w / 16 * 16));
+            crop_h = std::min<int64_t>(ih, std::max<int64_t>(1, std::llround(out_h / sc)));
+            crop_w = std::min<int64_t>(iw, std::max<int64_t>(1, std::llround(out_w / sc)));
+        }
+        const int64_t x0 = (iw - crop_w) / 2;
+        const int64_t y0 = (ih - crop_h) / 2;
+        auto cropped     = sd::ops::slice(image, 0, x0, x0 + crop_w);
+        cropped          = sd::ops::slice(cropped, 1, y0, y0 + crop_h);
+        auto fitted = sd::ops::interpolate(cropped, {out_w, out_h, image.shape()[2], image.shape()[3]},
+                                           sd::ops::InterpolateMode::Bicubic, false, true);
+        float* data = fitted.data();
+        for (int64_t k = 0; k < fitted.numel(); ++k) {
+            data[k] = std::min(1.0f, std::max(0.0f, data[k]));
+        }
+        return fitted;
+    }
