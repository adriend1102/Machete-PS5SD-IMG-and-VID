+fs::path model_canonical(const fs::path& path, std::error_code& ec) {
+    ec.clear();
+    fs::path result = fs::canonical(path, ec);
+    if (!ec && !result.empty())
+        return result;
+    ec.clear();
+    result = fs::absolute(path, ec).lexically_normal();
+    if (ec || result.empty() || !fs::exists(result, ec) || ec) {
+        if (!ec)
+            ec = std::make_error_code(std::errc::no_such_file_or_directory);
+        return {};
+    }
+    return result;
+}
