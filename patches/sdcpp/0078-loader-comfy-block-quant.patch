+// Describes a ComfyUI block-scaled weight (see block_quant.h): its logical [rows, cols]
+// shape, the ggml type it is converted to, and where its scales are in the file.
+static bool make_block_quant_storage(const nlohmann::json& header,
+                                     const std::string& name,
+                                     const std::string& module_name,
+                                     BlockQuantFormat format,
+                                     const ComfyQuantConfig& config,
+                                     size_t data_start,
+                                     size_t file_size,
+                                     TensorStorage& out,
+                                     std::string* error) {
+    struct Item {
+        std::string dtype;
+        std::vector<int64_t> shape;
+        uint64_t offset = 0;
+        uint64_t bytes  = 0;
+    };
+    auto find_item = [&](const std::string& key, Item& item) -> bool {
+        auto it = header.find(key);
+        if (it == header.end() || !it->is_object()) {
+            return false;
+        }
+        item.dtype         = it->value("dtype", "");
+        const size_t begin = (*it)["data_offsets"][0].get<size_t>();
+        const size_t end   = (*it)["data_offsets"][1].get<size_t>();
+        if (begin > end || end > file_size - data_start) {
+            return false;
+        }
+        for (const auto& d : (*it)["shape"]) {
+            item.shape.push_back(d.get<int64_t>());
+        }
+        item.offset = data_start + begin;
+        item.bytes  = end - begin;
+        return true;
+    };
+    auto fail = [&](const std::string& why) {
+        set_error(error, std::string("ComfyUI ") + sd::block_quant::format_name(format) + " weight '" + name + "': " + why);
+        return false;
+    };
+
+    Item weight;
+    if (!find_item(name, weight) || weight.shape.size() != 2) {
+        return fail("expected a 2D weight");
+    }
+    const int64_t rows = weight.shape[0];
+    int64_t cols       = weight.shape[1];
+    Item scale;
+    int bits = 4;
+    if (format == BlockQuantFormat::GROUPED_INT) {
+        Item channel, codebook, correction;
+        if (weight.dtype != "I8" && weight.dtype != "U8") {
+            return fail("unexpected weight dtype " + weight.dtype);
+        }
+        if (!find_item(module_name + ".weight_s_rel", scale) || scale.shape.size() != 2 || scale.shape[0] != rows) {
+            return fail("missing or misshapen weight_s_rel");
+        }
+        if (find_item(module_name + ".weight_correction", correction)) {
+            return fail("asymmetric correction tensors are not supported");
+        }
+        const int group = config.quant_group_size > 0 ? config.quant_group_size : 16;
+        cols            = scale.shape[1] * group;  // K from the scale grid, as comfy_kitchen infers it
+        if (cols <= 0 || (weight.shape[1] * 8) % cols != 0) {
+            return fail("packed width does not match the scale grid");
+        }
+        bits = static_cast<int>(weight.shape[1] * 8 / cols);
+        if (bits != 4 && bits != 6) {
+            return fail("only 4- and 6-bit codes are supported");
+        }
+        const uint64_t rel_size = scale.dtype == "F32" ? 4 : (scale.dtype == "F16" || scale.dtype == "BF16") ? 2 : 1;
+        if (scale.bytes != rel_size * static_cast<uint64_t>(rows) * static_cast<uint64_t>(scale.shape[1])) {
+            return fail("weight_s_rel size does not match");
+        }
+        if (!find_item(module_name + ".weight_s_channel", channel) ||
+            channel.bytes != (channel.dtype == "F32" ? 4u : 2u) * static_cast<uint64_t>(rows)) {
+            return fail("missing or misshapen weight_s_channel");
+        }
+        out.block_channel_scale_offset = channel.offset;
+        out.block_channel_scale_dtype  = channel.dtype;
+        if (find_item(module_name + ".weight_codebook", codebook)) {
+            const uint64_t elem = codebook.dtype == "F32" ? 4 : 2;
+            if (codebook.bytes != elem * (1u << bits) || bits != 4) {
+                return fail("unexpected weight_codebook");
+            }
+            out.block_codebook_offset = codebook.offset;
+            out.block_codebook_dtype  = codebook.dtype;
+            out.block_codebook_size   = 1 << bits;
+        }
+        const int rotation = config.group_size > 0 ? config.group_size : 256;
+        int r              = rotation;
+        while (r > 1 && r % 4 == 0) {
+            r /= 4;
+        }
+        if (r != 1 || rotation < 4 || cols % rotation != 0 || cols % group != 0) {
+            return fail("invalid convrot group size " + std::to_string(rotation));
+        }
+        out.block_rotation_group = rotation;
+        out.block_group_size     = group;
+        out.block_bits           = bits;
+    } else if (!find_item(module_name + ".weight_scale", scale)) {
+        return fail("missing weight_scale");
+    }
+    if (format == BlockQuantFormat::GROUPED_INT) {
+        // checked above
+    } else if (format == BlockQuantFormat::FLOAT8) {
+        if (weight.dtype != "F8_E4M3" && weight.dtype != "F8_E5M2") {
+            return fail("unexpected weight dtype " + weight.dtype);
+        }
+        const uint64_t elem = scale.dtype == "F32" ? 4 : 2;
+        if (scale.bytes != elem && scale.bytes != elem * static_cast<uint64_t>(rows)) {
+            return fail("expected one weight_scale, or one per row");
+        }
+        out.block_bits = weight.dtype == "F8_E5M2" ? 5 : 4;  // the exponent width of the codes
+    } else if (format == BlockQuantFormat::MXFP8) {
+        if (weight.dtype != "F8_E4M3" && weight.dtype != "U8") {
+            return fail("unexpected weight dtype " + weight.dtype);
+        }
+        if (cols % 32 != 0 || scale.bytes < sd::block_quant::swizzled_scale_bytes(rows, cols / 32)) {
+            return fail("block scales do not match the weight");
+        }
+    } else {
+        if (weight.dtype != "U8" && weight.dtype != "I8") {
+            return fail("unexpected weight dtype " + weight.dtype);
+        }
+        cols *= 2;  // two 4-bit codes per byte
+        if (format == BlockQuantFormat::NVFP4) {
+            if (cols % 16 != 0 || scale.bytes < sd::block_quant::swizzled_scale_bytes(rows, cols / 16)) {
+                return fail("block scales do not match the weight");
+            }
+            Item global;
+            if (!find_item(module_name + ".weight_scale_2", global) || global.dtype != "F32" || global.bytes != 4) {
+                return fail("missing F32 weight_scale_2");
+            }
+            out.block_global_scale_offset = global.offset;
+            Item pre;
+            if (find_item(module_name + ".pre_quant_scale", pre)) {
+                const uint64_t elem = pre.dtype == "F32" ? 4 : 2;
+                if (pre.bytes != elem * static_cast<uint64_t>(cols)) {
+                    return fail("pre_quant_scale does not match the weight");
+                }
+                out.block_pre_quant_scale_offset = pre.offset;
+                out.block_pre_quant_scale_dtype  = pre.dtype;
+            }
+        } else {
+            const int group = config.group_size > 0 ? config.group_size : 256;
+            int g           = group;
+            while (g > 1 && g % 4 == 0) {
+                g /= 4;
+            }
+            if (g != 1 || group < 4 || cols % group != 0) {
+                return fail("invalid convrot group size " + std::to_string(group));
+            }
+            const uint64_t elem = scale.dtype == "F32" ? 4 : 2;
+            if (scale.bytes != elem * static_cast<uint64_t>(rows)) {
+                return fail("expected one weight_scale per row");
+            }
+            out.block_rotation_group = group;
+        }
+    }
+
+    const int64_t ne[2] = {rows, cols};
+    TensorStorage built(name, sd::block_quant::storage_type(format, cols, bits), ne, 2, 0, weight.offset);
+    built.reverse_ne();
+    built.block_global_scale_offset    = out.block_global_scale_offset;
+    built.block_pre_quant_scale_offset = out.block_pre_quant_scale_offset;
+    built.block_pre_quant_scale_dtype  = out.block_pre_quant_scale_dtype;
+    built.block_rotation_group         = out.block_rotation_group;
+    built.block_channel_scale_offset   = out.block_channel_scale_offset;
+    built.block_channel_scale_dtype    = out.block_channel_scale_dtype;
+    built.block_codebook_offset        = out.block_codebook_offset;
+    built.block_codebook_dtype         = out.block_codebook_dtype;
+    built.block_codebook_size          = out.block_codebook_size;
+    built.block_group_size             = out.block_group_size;
+    built.block_bits                   = out.block_bits;
+    out                                = std::move(built);
+    out.block_quant        = format;
+    out.block_weight_bytes = weight.bytes;
+    out.block_scale_offset = scale.offset;
+    out.block_scale_bytes  = scale.bytes;
+    out.block_scale_dtype  = scale.dtype;
+    const uint64_t row_bytes = format == BlockQuantFormat::MXFP8 || format == BlockQuantFormat::FLOAT8 ? static_cast<uint64_t>(cols)
+                               : format == BlockQuantFormat::GROUPED_INT ? static_cast<uint64_t>(cols * bits / 8)
+                                                                         : static_cast<uint64_t>(cols / 2);
+    if (weight.bytes != static_cast<uint64_t>(rows) * row_bytes) {
+        return fail("weight size does not match its shape");
+    }
+    return true;
+}
