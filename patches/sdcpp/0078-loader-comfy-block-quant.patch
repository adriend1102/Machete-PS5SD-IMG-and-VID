+static BlockQuantFormat block_quant_format(const std::string& format) {
+    if (format == "mxfp8") {
+        return BlockQuantFormat::MXFP8;
+    }
+    if (format == "nvfp4") {
+        return BlockQuantFormat::NVFP4;
+    }
+    if (format == "convrot_w4a4") {
+        return BlockQuantFormat::CONVROT_W4A4;
+    }
+    if (format == "asym_w4a8_int8" || format == "w6a8_int8") {
+        return BlockQuantFormat::GROUPED_INT;
+    }
+    if (format == "float8_e4m3fn" || format == "float8_e5m2") {
+        return BlockQuantFormat::FLOAT8;
+    }
+    return BlockQuantFormat::NONE;
+}
